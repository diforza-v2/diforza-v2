<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
{%- if description %}
<meta name="description" content="{{ description }}">
{%- endif %}
{% include "partials/fonts.njk" %}
<link rel="stylesheet" href="/assets/css/main.css">
<script>window.SITE = {{ { whatsapp: site.whatsapp.number, waText: waText, catalogPdf: site.catalogo.pdf } | dump | safe }};</script>
</head>
<body>

{% include "partials/header.njk" %}
{{ content | safe }}
{% include "partials/footer.njk" %}
{% include "partials/catalog-modal.njk" %}
{%- if waText %}

{% include "partials/wa-float.njk" %}
{%- endif %}
{%- if phToggle %}
<button type="button" class="placeholder-toggle" id="phToggle" aria-pressed="false">Ocultar marcas</button>
{%- endif %}

{%- if site.turnstile.siteKey %}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{%- endif %}
<script src="/assets/js/main.js"></script>
{%- if pageJs %}
<script src="{{ pageJs }}"></script>
{%- endif %}
</body>
</html>
