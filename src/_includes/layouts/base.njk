<!DOCTYPE html>
<html lang="es-AR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{#- Verificaciones de propiedad del dominio (copiadas de TiendaNube el 15 oct): Search Console y Meta Business.
    Si se sacan, al pasar el dominio se pierde la verificación. -#}
<meta name="google-site-verification" content="{{ site.seo.verificacion.google }}">
<meta name="facebook-domain-verification" content="{{ site.seo.verificacion.meta }}">
<title>{{ title }}</title>
{%- if description %}
<meta name="description" content="{{ description }}">
{%- endif %}
{%- if noindex %}
<meta name="robots" content="noindex">
{%- endif %}
{#- SEO (doc 20 §5): canonical absoluta sin parámetros, Open Graph / Twitter y schema de la empresa.
    Por página: `canonical` (ruta), `ogImage` (ruta o URL), `ogType`. -#}
{%- set pageUrl = (canonical or page.url) | abs(site.url) %}
{%- set ogImg = (ogImage or site.seo.ogImage) | abs(site.url) %}
{%- if not noindex %}
<link rel="canonical" href="{{ pageUrl }}">
{%- endif %}
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="es_AR">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ ogTitle or title }}">
{%- if description %}
<meta property="og:description" content="{{ description }}">
{%- endif %}
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ ogImg }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/img/icons/favicon-96.png" type="image/png" sizes="96x96">
<link rel="icon" href="/img/icons/icon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": site.url + "/#organization",
      "name": site.name,
      "legalName": site.legal.razonSocial,
      "taxID": site.legal.cuit,
      "url": site.url + "/",
      "logo": site.seo.logo | abs(site.url),
      "description": site.seo.descripcion,
      "email": site.email,
      "telephone": site.phone.number,
      "sameAs": [site.social.instagram, site.social.facebook, site.social.linkedin]
    },
    {
      "@type": "Store",
      "@id": site.url + "/#store",
      "name": site.name,
      "parentOrganization": { "@id": site.url + "/#organization" },
      "url": site.url + "/",
      "image": site.seo.ogImage | abs(site.url),
      "telephone": site.phone.number,
      "email": site.email,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": site.seo.direccion.calle,
        "addressLocality": site.seo.direccion.ciudad,
        "addressRegion": site.seo.direccion.region,
        "postalCode": site.seo.direccion.cp,
        "addressCountry": site.seo.direccion.pais
      },
      "openingHours": site.seo.horario,
      "areaServed": { "@type": "Country", "name": "Argentina" }
    },
    {
      "@type": "WebSite",
      "@id": site.url + "/#website",
      "url": site.url + "/",
      "name": site.name,
      "inLanguage": "es-AR",
      "publisher": { "@id": site.url + "/#organization" }
    }
  ]
} | dump | safe }}</script>
{% include "partials/fonts.njk" %}
<link rel="stylesheet" href="/assets/css/main.css">
<script>window.SITE = {{ { whatsapp: site.whatsapp.number, waText: waText, catalogPdf: site.catalogo.pdf } | dump | safe }};</script>
{#- Medición (doc 08 §3): contexto de la página en el dataLayer ANTES de GTM. Sin datos personales. -#}
{%- set LANDING_IDS = { indumentaria: "l2-indumentaria", calzado: "calzado", epp: "l3-epp" } %}
{%- if p and p.linea %}{% set dlType = "producto" %}{% set dlLinea = p.linea.id %}
{%- elif s and s.linea %}{% set dlType = "subcategoria" %}{% set dlLinea = s.linea.id %}
{%- elif l and l.id %}{% set dlType = "linea" %}{% set dlLinea = l.id %}
{%- elif page.url == "/productos/" %}{% set dlType = "catalogo" %}
{%- elif landingKey %}{% set dlType = "landing" %}{% set dlLinea = landingKey %}
{%- elif page.url == "/" %}{% set dlType = "home" %}
{%- elif dlPageType %}{% set dlType = dlPageType %}{% set dlLinea = dlLinea %}
{%- elif page.url == "/404.html" %}{% set dlType = "404" %}
{%- elif page.url and "politica" in page.url %}{% set dlType = "legal" %}
{%- else %}{% set dlType = "otra" %}{% endif %}
{%- set dlCtx = { site_version: "v2", page_type: dlType, landing_id: (LANDING_IDS[landingKey] if landingKey else (dlLandingId or ("home" if dlType == "home" else undefined))), linea: dlLinea } %}
<script>
window.dataLayer = window.dataLayer || [];
(function(){
  var c = {{ dlCtx | dump | safe }};
  c.env = /(\.pages\.dev|localhost|127\.0\.0\.1)$/.test(location.hostname) ? 'staging' : 'production';
  window.dataLayer.push(c);
})();
{%- if dlType == "producto" %}
window.dataLayer.push({ ecommerce: null });
window.dataLayer.push({ event: 'view_item', ecommerce: { items: [{{ { item_id: p.id, item_name: p.nombre, item_brand: p.marca, item_category: p.linea.nombre, item_category2: p.sub.nombre, item_variant: (p.variantes[0].nombre if p.variantes and p.variantes.length > 1 else undefined) } | dump | safe }}] } });
{%- endif %}
</script>
{%- if site.gtmId %}{# gtmEnabled: false hasta publicar la versión de GTM preparada para el sitio nuevo (doc 08 §14). Con false igual carga GTM en modo Vista previa (Tag Assistant abre la URL con ?gtm_debug=; queda en sessionStorage para las páginas siguientes). #}
<script>(function(){var on={{ "true" if site.gtmEnabled else "false" }};try{if(/[?&]gtm_debug=/.test(location.search))sessionStorage.setItem('dfz_gtm_debug','1');if(sessionStorage.getItem('dfz_gtm_debug')==='1')on=true;}catch(e){}if(!on)return;(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ site.gtmId }}');})();</script>
{%- endif %}
</head>
<body>
{%- if site.gtmId and site.gtmEnabled %}
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.gtmId }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
{%- endif %}

{% include "partials/header.njk" %}
{{ content | safe }}
{% include "partials/footer.njk" %}
{% include "partials/catalog-modal.njk" %}
{%- if waText %}

{% include "partials/wa-float.njk" %}
{%- endif %}
{%- if phToggle %}
<button type="button" class="placeholder-toggle" id="phToggle" aria-pressed="false">Ocultar marcas</button>
{%- endif %}

{%- if site.turnstile.siteKey %}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{%- endif %}
<script src="/assets/js/main.js"></script>
{%- if pageJs %}
<script src="{{ pageJs }}"></script>
{%- endif %}
</body>
</html>
