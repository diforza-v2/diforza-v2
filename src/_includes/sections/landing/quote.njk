{#- Cotización (#contacto): copy + WhatsApp + acceso al catálogo (ventana) + formulario. Datos: L.cotizacion; waText del front matter -#}
{%- set Q = L.cotizacion %}
<section class="quote theme-dark" id="contacto">
  <div class="quote__inner">
    <div class="quote__copy reveal">
      <h2 class="section-title">{{ Q.titulo | rich | safe }}</h2>
      <p class="quote__reply">{{ Q.respuesta | rich | safe }}</p>

      <div class="quote__reviews" data-js="review-rotator" role="region" aria-label="Reseñas de clientes en Google">
        <div class="quote__reviews-track">
{%- for nombre, r in reviews %}
          <figure class="quote__mini{% if loop.first %} is-active{% endif %}"{% if not loop.first %} aria-hidden="true"{% endif %}>
            <div class="quote__stars" role="img" aria-label="5 de 5 estrellas"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" fill="currentColor"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" fill="currentColor"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" fill="currentColor"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" fill="currentColor"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" fill="currentColor"/></svg></div>
            <p>“{{ r.texto }}”</p>
            <cite>{{ nombre }} <span>· Google Reviews</span></cite>
          </figure>
{%- endfor %}
        </div>
        <div class="quote__dots">
{%- for nombre, r in reviews %}
          <button type="button" class="quote__dot{% if loop.first %} is-active{% endif %}" aria-label="Ver reseña de {{ nombre }}"{% if loop.first %} aria-current="true"{% endif %}></button>
{%- endfor %}
        </div>
      </div>

      <a href="https://wa.me/{{ site.whatsapp.number }}?text={{ waText | urlencode }}" class="btn btn--primary btn--icon quote__wa" data-js="wa" target="_blank" rel="noopener">{{ icons['ui-whatsapp'] | safe }} {{ site.cta.whatsapp }}</a>
      <p class="quote__hint">Cotizá directo por chat, sin completar formularios.</p>

      <div class="catalog" id="catalogo">
        <a href="#catalogo" class="catalog__toggle" data-js="catalogo">
          <span>{{ Q.catalogo }}<small>Indumentaria, calzado y EPP en un PDF. Se descarga al instante.</small></span>
          {{ icons['ui-descarga'] | safe }}
        </a>
      </div>
    </div>

    <div class="lead-form reveal reveal--1" id="form-cotizacion-wrap">
      <form id="form-cotizacion" data-js="lead-form" novalidate>
        <p class="lead-form__title">{{ Q.formTitulo | rich | safe }}</p>
        <p class="lead-form__note">Los campos con <span class="lead-form__required">*</span> son obligatorios.</p>

        <div class="quote-product" id="quoting" hidden>
          <span>Estás cotizando: <strong id="quotingName"></strong></span>
          <button type="button" id="quotingClear">Quitar</button>
        </div>

        <input type="hidden" name="producto_interes" id="productoInteres" value="">
        <input type="hidden" name="tipo_lead" value="cotizacion">
        <input type="hidden" name="landing" value="{{ Q.landingId }}">
        <div class="hp-field" aria-hidden="true"><label>No completar<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>

        <div class="lead-form__grid">
          <div class="field">
            <label for="f-nombre">Nombre <span class="field__required">*</span></label>
            <input id="f-nombre" name="nombre" type="text" autocomplete="name" required>
            <span class="field__error">Ingresá tu nombre.</span>
          </div>
          <div class="field">
            <label for="f-empresa">Empresa <span class="field__required">*</span></label>
            <input id="f-empresa" name="empresa" type="text" autocomplete="organization" required>
            <span class="field__error">Ingresá el nombre de tu empresa.</span>
          </div>
          <div class="field">
            <label for="f-email">Email corporativo <span class="field__required">*</span></label>
            <input id="f-email" name="email" type="email" inputmode="email" autocomplete="email" required>
            <span class="field__error">Ingresá un email válido.</span>
          </div>
          <div class="field">
            <label for="f-tel">Teléfono / WhatsApp <span class="field__required">*</span></label>
            <input id="f-tel" name="telefono" type="tel" inputmode="tel" autocomplete="tel" required>
            <span class="field__error">Ingresá un teléfono de contacto.</span>
          </div>
          <div class="field field--full">
            <label for="f-rubro">Rubro / industria <small class="field__optional">(opcional)</small></label>
            <select id="f-rubro" name="rubro">
              <option value="">Elegí una opción</option>
              {%- for r in landingForm.rubros %}
              <option>{{ r }}</option>
              {%- endfor %}
            </select>
            <span class="field__error">Elegí el rubro de tu empresa.</span>
          </div>
          <div class="field field--full">
            <label for="f-mensaje">Contanos qué necesitás</label>
            <textarea id="f-mensaje" name="mensaje" rows="3"></textarea>
          </div>
          <div class="field field--full">
            <label class="check"><input type="checkbox" name="consentimiento" required checked> <span>Acepto la <a href="{{ site.legal.privacidad }}" target="_blank">política de privacidad</a>.</span></label>
            <span class="field__error">Para contactarte necesitamos que aceptes la política de privacidad.</span>
          </div>
          <div class="field--full">
            {%- if site.turnstile.siteKey %}<div class="cf-turnstile" data-sitekey="{{ site.turnstile.siteKey }}" data-appearance="interaction-only" data-action="cotizacion"></div>{%- endif %}
            <button type="submit" class="btn btn--primary lead-form__submit">{{ Q.formBoton }} {{ icons['ui-flecha'] | safe }}</button>
            <p class="lead-form__status" data-js="form-status" role="status" aria-live="polite"></p>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>
