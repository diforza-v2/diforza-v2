    - { icono: "mascara-facial", titulo: "Pintura y fumigación", texto: "Frena salpicaduras leves y polvo sin dar calor: la tela respira.", wa: "pintura o fumigación" }
    - { icono: "probeta", titulo: "Laboratorios", texto: "Capucha y elásticos en puños y tobillos para trabajar cubierto.", wa: "laboratorio" }
    - { icono: "portapapeles", titulo: "Mantenimiento e industria", texto: "Polvo, grasa y suciedad: se usa en la tarea y se descarta.", wa: "mantenimiento industrial" }
