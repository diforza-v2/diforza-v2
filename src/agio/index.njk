  usos:
    - { icono: "portapapeles", titulo: "Mantenimiento", texto: "Para agacharse, arrodillarse y subir escaleras sin que el pantalón tire.", wa: "mantenimiento" }
    - { icono: "caja", titulo: "Logística y depósito", texto: "Carga y descarga todo el día, con los bolsillos cargo a mano.", wa: "logística y depósito" }
    - { icono: "rayo", titulo: "Instalaciones", texto: "Electricistas, gasistas e instaladores que trabajan en posiciones incómodas.", wa: "instalaciones" }
    - { icono: "casco", titulo: "Construcción", texto: "Gabardina resistente y costuras reforzadas para el uso intensivo en obra.", wa: "construcción" }
    - { icono: "camion", titulo: "Técnicos en campo", texto: "Mucho movimiento, auto y calle: cómodo de la mañana a la noche.", wa: "técnicos en campo" }
    - { icono: "persona", titulo: "Uniforme de equipo", texto: "5 colores y el logo de tu empresa bordado o estampado.", wa: "el uniforme de mi equipo" }
  colores:
    - { id: "negro", nombre: "Negro", foto: "/img/catalogo/pantalon-cargo-elastizado-diforza--negro.webp" }
