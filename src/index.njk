<section class="solve">
  <div class="solve__inner">
    <div class="solve__copy reveal">
      <p class="solve__eyebrow">Todo lo que tu equipo necesita</p>

      <h2>Resolvé el equipamiento <br> de tu personal en un <br> solo lugar</h2>

      <p class="solve__lead">Indumentaria, calzado y elementos de protección personal. Soluciones confiables para una industria más segura.</p>

      <div class="ctas">
        <a href="#contacto" class="btn btn--primary">Pedir cotización
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10h13m0 0l-5-5m5 5l-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#catalogo" class="btn btn--outline" data-js="catalogo">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3v9m0 0l-3.5-3.5M10 12l3.5-3.5M3.5 15.5h13"/></svg>
          Descargar catálogo
        </a>
      </div>

      <div class="solve__marks">
        <div class="solve__mark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.9l8.2 4.3v9.6L12 21.1l-8.2-4.3V7.2z"/><path d="M3.8 7.2L12 11.5l8.2-4.3M12 11.5v9.6"/></svg>
